{
    "openapi": "3.0.0",
    "info": {
        "title": "Projeto Hospitalar Web II API",
        "description": "Projeto para gerenciamento hospitalar, incluindo convênios, planos e tipos de cobrança. Esse projeto foi desenvolvido utilizando Laravel, React, ",
        "contact": {
            "name": "Seu Nome",
            "email": "seu-email@exemplo.com"
        },
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8000/api",
            "description": "Ambiente de Desenvolvimento"
        }
    ],
    "paths": {
        "/convenios": {
            "get": {
                "summary": "Listar todos os convênios",
                "description": "Retorna uma lista de todos os convênios médicos cadastrados.",
                "operationId": "9694af025ecd119730dd7974d9bddc46",
                "responses": {
                    "200": {
                        "description": "Lista de convênios retornada com sucesso."
                    },
                    "500": {
                        "description": "Erro interno do servidor."
                    }
                }
            },
            "post": {
                "summary": "Criar um novo convênio",
                "description": "Cria um novo convênio médico.",
                "operationId": "f767a1885a17747c4794ed71ffca8bbc",
                "parameters": [
                    {
                        "name": "convenio",
                        "in": "path",
                        "description": "ID do convênio que será atualizado",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "requestBody": {
                    "description": "Objeto Convênio a ser transportado",
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Convenio"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Convênio criado com sucesso."
                    },
                    "500": {
                        "description": "Erro interno do servidor."
                    }
                }
            }
        },
        "/convenios/{convenio}": {
            "put": {
                "summary": "Atualizar um convênio existente",
                "description": "Atualiza as informações de um convênio médico existente.",
                "operationId": "b67be6643e67428f47d0f14e81dc92b4",
                "parameters": [
                    {
                        "name": "convenio",
                        "in": "path",
                        "description": "ID do convênio que será atualizado",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "requestBody": {
                    "description": "Objeto Convênio a ser transportado",
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Convenio"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Convênio atualizado com sucesso."
                    },
                    "500": {
                        "description": "Erro interno do servidor."
                    }
                }
            },
            "delete": {
                "summary": "Excluir um convênio existente",
                "description": "Exclui um convênio médico existente.",
                "operationId": "074b659d134f9478218268a92bc834e1",
                "parameters": [
                    {
                        "name": "convenio",
                        "in": "path",
                        "description": "ID do convênio que será atualizado",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "requestBody": {
                    "description": "Objeto Convênio a ser transportado",
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Convenio"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Convênio excluído com sucesso."
                    },
                    "500": {
                        "description": "Erro interno do servidor."
                    }
                }
            }
        },
        "/api/planos": {
            "get": {
                "summary": "Listar todos os planos",
                "description": "Retorna uma lista de todos os planos médicos cadastrados.",
                "operationId": "f756579110476a0107fbee0941c9449d",
                "responses": {
                    "200": {
                        "description": "Lista de planos retornada com sucesso."
                    },
                    "500": {
                        "description": "Erro interno do servidor."
                    }
                }
            }
        },
        "/api/tipos-cobranca": {
            "get": {
                "summary": "Listar todos os tipos de cobrança",
                "description": "Retorna uma lista de todos os tipos de cobrança cadastrados.",
                "operationId": "8615f7ead74331e0e1027c87cf9463d3",
                "responses": {
                    "200": {
                        "description": "Lista de tipos de cobrança retornada com sucesso."
                    },
                    "500": {
                        "description": "Erro interno do servidor."
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "Convenio": {
                "title": "Objeto Convenio",
                "description": "Modelo de dados que representa um convênio médico",
                "required": [
                    "nome",
                    "cnpj",
                    "telefone",
                    "email",
                    "id_endereco"
                ],
                "properties": {
                    "nome": {
                        "description": "Nome do convênio",
                        "type": "string",
                        "example": "Amil Saúde"
                    },
                    "cnpj": {
                        "description": "CNPJ do convênio",
                        "type": "string",
                        "example": "12.345.678/0001-99"
                    },
                    "telefone": {
                        "description": "Telefone de contato",
                        "type": "string",
                        "example": "(11) 91234-5678"
                    },
                    "email": {
                        "description": "E-mail do convênio",
                        "type": "string",
                        "example": "contato@amil.com"
                    },
                    "id_endereco": {
                        "description": "ID do endereço vinculado",
                        "type": "integer",
                        "example": 1
                    }
                },
                "type": "object"
            }
        },
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "scheme": "bearer"
            }
        }
    }
}